# Copy to .env; use single quotes if a value contains $ or #.
RTSP_URL='rtsp://username:password@192.168.1.100:554/stream'
ASR_API_URL=http://172.16.20.163:17003/v1/audio/transcriptions
ASR_MODEL=qwen3-asr-0.6b
ASR_LANGUAGE=zh
ASR_API_KEY=
ASR_EXTRA_FORM='{}'
TZ=Asia/Shanghai

WEB_BIND=127.0.0.1
WEB_PORT=8080
# Set both to enable HTTP Basic authentication.
WEB_USERNAME=
WEB_PASSWORD=

# Keep N calendar dates including today. 0 disables expiration.
RETENTION_DAYS=7
CLEANUP_INTERVAL_SECONDS=3600
SAVE_RAW_JSON=false
AUDIO_PREFIX=meeting

# 0 = least aggressive, 3 = most aggressive.
VAD_MODE=2
RMS_THRESHOLD=20
MIN_SPEECH_MS=300
SILENCE_MS=600
PADDING_MS=300
MAX_SEGMENT_SECONDS=45

ASR_WORKERS=1
QUEUE_SIZE=10
ASR_CONNECT_TIMEOUT=10
ASR_TIMEOUT=180
ASR_RETRY_COUNT=2
RECONNECT_DELAY=5
FFMPEG_TIMEOUT=20
STALL_TIMEOUT=30
STATUS_INTERVAL=60
SHOW_FFMPEG_LOG=false
